# =========================================================================
# PANDUAN PENGATURAN API KEY & KONFIGURASI STORE
# Ubah nilai di bawah sesuai dengan layanan yang Anda gunakan.
# =========================================================================

# 1. SERVER CONFIGURATION
PORT=3000
JWT_SECRET=rahasia-jwt-super-aman-ganti-ini-dengan-string-acak-panjang
STORE_NAME="X-Store Digital"
STORE_URL=http://localhost:3000

# 2. PAYMENT GATEWAY (PILIH: 'simulator', 'pakasir', ATAU 'tripay')
# - simulator: Mode uji coba bawaan (langsung jalan tanpa daftar gateway, ada tombol simulasi bayar)
# - pakasir: Gateway otomatis QRIS & VA Indonesia (Daftar di https://pakasir.com)
# - tripay: Gateway alternatif (Daftar di https://tripay.co.id)
GATEWAY_PROVIDER=simulator

# === JIKA MENGGUNAKAN PAKASIR ===
# Dapatkan di dashboard: https://pakasir.com/dashboard/developer
PAKASIR_PROJECT_ID=
PAKASIR_API_KEY=
PAKASIR_WEBHOOK_SECRET=

# === JIKA MENGGUNAKAN TRIPAY ===
# Dapatkan di dashboard: https://tripay.co.id/developer
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
TRIPAY_MERCHANT_CODE=

# 3. LAYANAN EMAIL TRANSAKSIONAL (Kirim Akun & Bukti Pembelian ke Email Pelanggan)
# - OPSI A: Resend API (Sangat Direkomendasikan, gratis 3.000 email/bulan, daftar di https://resend.com)
RESEND_API_KEY=

# - OPSI B: SMTP Biasa (Misal: Gmail SMTP atau cPanel Webmail)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=support@xstore.id

# 4. PROVIDER GAME & PPOB OTOMATIS (OPSIONAL, jika ingin jual Top Up Game & Pulsa)
# Daftar di: https://digiflazz.com
DIGIFLAZZ_USERNAME=
DIGIFLAZZ_API_KEY=
